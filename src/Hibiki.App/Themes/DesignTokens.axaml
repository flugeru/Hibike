<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared values for the dark mobile and desktop interface. -->
  <x:Double x:Key="PagePadding">16</x:Double>
  <x:Double x:Key="Space4">4</x:Double>
  <x:Double x:Key="Space8">8</x:Double>
  <x:Double x:Key="Space12">12</x:Double>
  <x:Double x:Key="Space16">16</x:Double>
  <x:Double x:Key="Space24">24</x:Double>
  <x:Double x:Key="TouchTarget">48</x:Double>
  <x:Double x:Key="TrackRowHeight">64</x:Double>
  <x:Double x:Key="TrackThumbSize">52</x:Double>
  <x:Double x:Key="NavigationHeight">72</x:Double>
  <x:Double x:Key="NavigationPillWidth">56</x:Double>
  <x:Double x:Key="NavigationPillHeight">28</x:Double>
  <x:Double x:Key="MiniPlayVisualSize">40</x:Double>
  <x:Double x:Key="ProgressHeight">3</x:Double>
  <x:Double x:Key="PlayerMaxWidth">420</x:Double>
  <x:Double x:Key="PlayerPlaySize">72</x:Double>
  <x:Double x:Key="PlayerSkipIconSize">32</x:Double>
  <x:Double x:Key="SliderRailHeight">4</x:Double>
  <x:Double x:Key="SliderThumbSize">14</x:Double>
  <CornerRadius x:Key="ThumbRadius">8</CornerRadius>
  <CornerRadius x:Key="CardRadius">16</CornerRadius>
  <CornerRadius x:Key="CoverRadius">24</CornerRadius>
  <CornerRadius x:Key="PillRadius">999</CornerRadius>
  <Thickness x:Key="PageInsets">16,0</Thickness>
  <Thickness x:Key="CompactPageInsets">16,8,16,4</Thickness>
  <Thickness x:Key="DesktopPageInsets">32,24,32,12</Thickness>
  <Thickness x:Key="MiniMargin">16,0,16,8</Thickness>
  <Thickness x:Key="MiniContentInsets">8,4</Thickness>
  <Thickness x:Key="MiniProgressMargin">8,0,8,8</Thickness>
  <Thickness x:Key="NavInsets">8,4</Thickness>
  <Thickness x:Key="SideNavInsets">12,8</Thickness>
  <Thickness x:Key="PlayerColumnMargin">0,8,0,16</Thickness>
  <Thickness x:Key="PlayerArtMargin">0,8,0,16</Thickness>
  <Thickness x:Key="PlayerMetadataMargin">0,0,0,12</Thickness>
  <Thickness x:Key="PlayerControlMargin">0,16,0,0</Thickness>
  <Thickness x:Key="PlayerNextMargin">0,16,0,0</Thickness>
  <Thickness x:Key="HeaderMargin">0,0,0,4</Thickness>
  <Thickness x:Key="HeadingMargin">0,8,0,0</Thickness>
  <Thickness x:Key="StatusInsets">12,4</Thickness>
  <Thickness x:Key="SidebarMargin">16,24</Thickness>
  <Thickness x:Key="SidebarHeadingMargin">12,0,0,24</Thickness>
  <Thickness x:Key="EmptyStateMargin">12,56,12,0</Thickness>
  <Thickness x:Key="SheetInsets">24</Thickness>
  <Thickness x:Key="ButtonPadding">16,8</Thickness>
  <Thickness x:Key="SearchPadding">12,8</Thickness>
  <Thickness x:Key="SearchIconMargin">12,0,4,0</Thickness>
  <Thickness x:Key="NoThickness">0</Thickness>
  <Color x:Key="AccentColor">#BDA2FF</Color>
  <SolidColorBrush x:Key="Background">#000000</SolidColorBrush>
  <SolidColorBrush x:Key="Surface">#000000</SolidColorBrush>
  <SolidColorBrush x:Key="SurfaceElevated">#000000</SolidColorBrush>
  <SolidColorBrush x:Key="TextPrimary">#F7F7F7</SolidColorBrush>
  <SolidColorBrush x:Key="TextSecondary">#C5C5C5</SolidColorBrush>
  <SolidColorBrush x:Key="TextTertiary">#ACACAC</SolidColorBrush>
  <SolidColorBrush x:Key="Accent">#BDA2FF</SolidColorBrush>
  <SolidColorBrush x:Key="OnAccent">#211337</SolidColorBrush>
  <SolidColorBrush x:Key="Outline">#333333</SolidColorBrush>
  <SolidColorBrush x:Key="TrackRail">#444444</SolidColorBrush>
  <SolidColorBrush x:Key="Hover">#000000</SolidColorBrush>
  <SolidColorBrush x:Key="Pressed">#000000</SolidColorBrush>
  <SolidColorBrush x:Key="ActivePill">#000000</SolidColorBrush>
  <SolidColorBrush x:Key="Overlay">#BA000000</SolidColorBrush>
  <Color x:Key="PlaceholderStart">#181818</Color>
  <Color x:Key="PlaceholderEnd">#050505</Color>
  <Color x:Key="BackgroundColor">#000000</Color>
  <x:String x:Key="CardShadow">0 0 0 0 #00000000</x:String>
  <LinearGradientBrush x:Key="ListFadeTop" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#000000" Offset="0" /><GradientStop Color="#00000000" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ListFadeBottom" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Color="#00000000" Offset="0" /><GradientStop Color="#000000" Offset="1" />
  </LinearGradientBrush>
  <ControlTheme x:Key="PlayerSliderRailButton" TargetType="RepeatButton">
    <Setter Property="Template">
      <ControlTemplate><Border Height="{DynamicResource SliderRailHeight}" Background="{TemplateBinding Background}"
                               CornerRadius="{DynamicResource PillRadius}" /></ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="PlayerSliderThumb" TargetType="Thumb">
    <Setter Property="Template">
      <ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource PillRadius}" /></ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="PlayerSlider" TargetType="Slider">
    <Setter Property="MinHeight" Value="{DynamicResource TouchTarget}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
               Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="Horizontal">
          <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Background="{DynamicResource Accent}"
              Theme="{StaticResource PlayerSliderRailButton}" Focusable="False" /></Track.DecreaseButton>
          <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Background="{DynamicResource TrackRail}"
              Theme="{StaticResource PlayerSliderRailButton}" Focusable="False" /></Track.IncreaseButton>
          <Thumb Name="PlayerThumb" Width="{DynamicResource SliderThumbSize}" Height="{DynamicResource SliderThumbSize}"
                 Background="{DynamicResource Accent}" Theme="{StaticResource PlayerSliderThumb}" />
        </Track>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
