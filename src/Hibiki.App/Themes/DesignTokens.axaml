<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Hibiki: one source of truth for dimensions, radii and accessible colors. -->
  <x:Double x:Key="PagePadding">16</x:Double>
  <x:Double x:Key="Space4">4</x:Double>
  <x:Double x:Key="Space8">8</x:Double>
  <x:Double x:Key="Space12">12</x:Double>
  <x:Double x:Key="Space16">16</x:Double>
  <x:Double x:Key="Space24">24</x:Double>
  <x:Double x:Key="Space0">0</x:Double>
  <x:Double x:Key="RadiusThumb">8</x:Double>
  <x:Double x:Key="RadiusCard">16</x:Double>
  <x:Double x:Key="RadiusCover">24</x:Double>
  <x:Double x:Key="RadiusPill">999</x:Double>
  <x:Double x:Key="RadiusTiny">4</x:Double>
  <x:Double x:Key="TouchTarget">48</x:Double>
  <x:Double x:Key="RowHeight">64</x:Double>
  <x:Double x:Key="ThumbSize">52</x:Double>
  <x:Double x:Key="MiniThumbSize">40</x:Double>
  <x:Double x:Key="MiniPlayerHeight">72</x:Double>
  <x:Double x:Key="NavHeight">68</x:Double>
  <x:Double x:Key="PlayerPlaySize">72</x:Double>
  <x:Double x:Key="PlayerIconSize">32</x:Double>
  <x:Double x:Key="IconSize">24</x:Double>
  <x:Double x:Key="ProgressHeight">3</x:Double>
  <x:Double x:Key="SeekHeight">4</x:Double>
  <x:Double x:Key="SeekThumb">14</x:Double>
  <x:Double x:Key="TrackBorder">1</x:Double>
  <x:Double x:Key="IndicatorWidth">56</x:Double>
  <x:Double x:Key="IndicatorHeight">32</x:Double>
  <x:Double x:Key="MaxContentWidth">420</x:Double>
  <x:Double x:Key="SidebarWidth">200</x:Double>
  <x:Double x:Key="DesktopBreakpoint">800</x:Double>
  <x:Double x:Key="TypeBrand">22</x:Double>
  <x:Double x:Key="TypeHeading">18</x:Double>
  <x:Double x:Key="TypeTitle">14</x:Double>
  <x:Double x:Key="TypeBody">14</x:Double>
  <x:Double x:Key="TypeCaption">12</x:Double>
  <x:Double x:Key="TypePlayerTitle">22</x:Double>
  <x:Double x:Key="TypeArtist">14</x:Double>
  <x:Double x:Key="TypeNav">12</x:Double>
  <x:Double x:Key="TypeSection">16</x:Double>
  <x:Double x:Key="TypeButton">14</x:Double>
  <x:Double x:Key="AnimationMs">160</x:Double>
  <x:Double x:Key="PlayerArtworkRatio">0.40</x:Double>
  <x:Double x:Key="FavoritePressedOpacity">0.70</x:Double>
  <x:Double x:Key="DominantDarken">0.26</x:Double>
  <x:String x:Key="CoverShadow">0 8 24 0 #48000000</x:String>
  <SolidColorBrush x:Key="BackgroundBrush" Color="#100E17"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#1D1927"/>
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#30263D"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#3B304C"/>
  <SolidColorBrush x:Key="SurfacePressedBrush" Color="#4D3B62"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAF7FF"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#D7CFE2"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#BEB1CF"/>
  <Color x:Key="AccentColor">#BDA2FF</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#CAB4FF"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#A98BEA"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#211337"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#51415F"/>
  <SolidColorBrush x:Key="TrackBrush" Color="#51465E"/>
  <SolidColorBrush x:Key="ScrimBrush" Color="#BA000000"/>
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
  <SolidColorBrush x:Key="CoverStartBrush" Color="#69459B"/>
  <SolidColorBrush x:Key="CoverEndBrush" Color="#242031"/>
  <SolidColorBrush x:Key="CoverWaveBrush" Color="#D5BFFF"/>
  <SolidColorBrush x:Key="PlayerGradientTopBrush" Color="#38254A"/>
  <SolidColorBrush x:Key="PlayerGradientBottomBrush" Color="#100E17"/>
  <Thickness x:Key="PageInsets">16</Thickness>
  <Thickness x:Key="CardInsets">12</Thickness>
  <Thickness x:Key="ButtonInsets">12,8</Thickness>
  <Thickness x:Key="NoInsets">0</Thickness>
  <!-- High-contrast, rounded 4dp seek track and 14dp thumb.
       The PART_Track name and TwoWay Value preserve keyboard/touch seeking. -->
  <ControlTheme x:Key="HibikiSeekSlider" TargetType="Slider">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Height="{StaticResource TouchTarget}">
          <Track Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 Orientation="Horizontal">
            <Track.DecreaseButton>
              <RepeatButton Focusable="False">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Height="{StaticResource SeekHeight}"
                            CornerRadius="{StaticResource RadiusPill}"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center"/>
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Focusable="False">
                <RepeatButton.Template>
                  <ControlTemplate>
                    <Border Height="{StaticResource SeekHeight}"
                            CornerRadius="{StaticResource RadiusPill}"
                            Background="{StaticResource TrackBrush}"
                            VerticalAlignment="Center"/>
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseButton>
            <Thumb Name="PART_Thumb" Width="{StaticResource SeekThumb}"
                   Height="{StaticResource SeekThumb}" BorderThickness="0">
              <Thumb.Template>
                <ControlTemplate>
                  <Border CornerRadius="{StaticResource RadiusPill}"
                          Background="{StaticResource AccentBrush}"/>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed /template/ Thumb#PART_Thumb">
      <Setter Property="Width" Value="{StaticResource IconSize}"/>
      <Setter Property="Height" Value="{StaticResource IconSize}"/>
    </Style>
  </ControlTheme>
</ResourceDictionary>