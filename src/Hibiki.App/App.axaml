<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="Hibiki.App.App" RequestedThemeVariant="Dark">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Hibiki.App/Themes/DesignTokens.axaml" />
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Application.Resources>
 <Application.Styles>
  <FluentTheme>
   <FluentTheme.Palettes><ColorPaletteResources x:Key="Dark" Accent="{StaticResource AccentColor}" /></FluentTheme.Palettes>
  </FluentTheme>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></Style>
  <Style Selector="Button">
   <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" /><Setter Property="MinHeight" Value="{DynamicResource TouchTarget}" />
   <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" /><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
   <Setter Property="BorderThickness" Value="{DynamicResource NoThickness}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource OnAccent}" /></Style>
  <Style Selector="Button.subtle"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.nav.active"><Setter Property="Background" Value="{DynamicResource SurfaceElevated}" /></Style>
  <Style Selector="Button.nav.bottom-nav"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.track"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="{DynamicResource NoThickness}" /></Style>
  <Style Selector="Button.chip"><Setter Property="CornerRadius" Value="{DynamicResource PillRadius}" /><Setter Property="Background" Value="{DynamicResource Surface}" /></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" /><Setter Property="MinHeight" Value="{DynamicResource TouchTarget}" /><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Outline}" /><Setter Property="Padding" Value="{DynamicResource SearchPadding}" /></Style>
  <Style Selector="ListBox.music-list"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="{DynamicResource NoThickness}" /><Setter Property="Padding" Value="{DynamicResource NoThickness}" /></Style>
  <Style Selector="ListBox.music-list ListBoxItem"><Setter Property="Padding" Value="{DynamicResource NoThickness}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="ListBox.music-list ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Slider"><Setter Property="MinHeight" Value="{DynamicResource Space24}" /></Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource Pressed}" />
  </Style>
  <Style Selector="ScrollViewer">
   <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
   <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
  </Style>
 </Application.Styles>
</Application>
