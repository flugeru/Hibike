<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hibiki.App.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/DesignTokens.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#BDA2FF"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
      <Setter Property="MinHeight" Value="{StaticResource TouchTarget}"/>
      <Setter Property="Padding" Value="{StaticResource ButtonInsets}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource TypeButton}"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="{StaticResource SurfacePressedBrush}"/>
    </Style>
    <!-- Fluent changes the template presenter separately from Button.Background. -->
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{TemplateBinding Background}"/>
      <Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{TemplateBinding Background}"/>
      <Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
    </Style>
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
    </Style>
    <Style Selector="Button.nav.bottom-nav.active">
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
    </Style>
    <Style Selector="Button.nav:pointerover, Button.track:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="Button.nav:pressed, Button.track:pressed">
      <Setter Property="Background" Value="{StaticResource SurfacePressedBrush}"/>
    </Style>
    <Style Selector="Button.track">
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
      <Setter Property="MinHeight" Value="{StaticResource TouchTarget}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource TypeBody}"/>
      <Setter Property="Padding" Value="{StaticResource ButtonInsets}"/>
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="{StaticResource NoInsets}"/>
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:pressed">
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
    </Style>
    <Style Selector="Slider">
      <Setter Property="MinHeight" Value="{StaticResource TouchTarget}"/>
    </Style>
  </Application.Styles>
</Application>