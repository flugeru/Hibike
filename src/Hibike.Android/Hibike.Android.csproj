<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>com.flugel.hibike</ApplicationId>
    <ApplicationTitle>Hibike</ApplicationTitle>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- ponytail: use dynamic JNI registration until optimized Release callbacks pass device startup checks. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidStripNativeLibraries>false</AndroidStripNativeLibraries>
    <DefineConstants Condition="'$(HibikeSmokeTests)' == 'true'">$(DefineConstants);HIBIKE_SMOKE_TEST</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hibike.App/Hibike.App.csproj" />
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.GooglePlayServices.Auth" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Hls" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Session" />
    <AndroidNativeLibrary Include="Native/**/*.so" />
    <AndroidAsset Include="../../THIRD-PARTY-NOTICES.md" Link="licenses/THIRD-PARTY-NOTICES.md" />
    <AndroidAsset Include="../../scripts/LICENSE.youtubedl-android.txt" Link="licenses/GPL-3.0.txt" />
    <AndroidAsset Include="../../scripts/LICENSE.media3.txt" Link="licenses/Apache-2.0.txt" />
  </ItemGroup>
  <Target Name="RequireBundledRuntime" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('Assets/runtime/yt-dlp')" Text="Run python3 scripts/prepare_android_runtime.py before building Android (GitHub Actions does this automatically)." />
  </Target>
</Project>
